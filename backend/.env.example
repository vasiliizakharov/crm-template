JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080
APP_ENV=production
CORS_ORIGINS=https://example.com
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator
