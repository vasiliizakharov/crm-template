# Top-level env file consumed by docker-compose.
# Copy to .env and fill in real values. Never commit .env.

# Postgres password (set a strong unique value)
PG_PASSWORD=

# JWT signing secret. Use 32+ random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=

# Initial admin user (created idempotently on first boot)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator

# Comma-separated allowed origins for CORS
CORS_ORIGINS=https://example.com
